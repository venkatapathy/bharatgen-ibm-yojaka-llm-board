# EduQGen local environment
# Copy to .env:  cp .env.example .env

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Postgres (DB_HOST is overridden to "db" by docker-compose)
DB_NAME=qgen_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (overridden by docker-compose)
REDIS_URL=redis://localhost:6379/0

# LLM / OCR — point at YOUR Ollama (or leave blank and configure later)
# Mac/Windows Docker Desktop often:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# Linux: use your machine LAN IP, e.g. http://192.168.x.x:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional cloud keys
GROQ_API_KEY=

# Optional Unlimited-OCR sidecar (leave defaults if unused)
# UNLIMITED_OCR_URL=
# UNLIMITED_OCR_MODEL=frob/unlimited-ocr:q8_0
PDF_FORCE_UNLIMITED_OCR=0
